<Project>
  <!-- The Genesis build standard: sibling modules by source inside Genesis, by package alone. See eng/Genesis.props. -->
  <Import Project="$(MSBuildThisFileDirectory)eng/Genesis.props" />
  <PropertyGroup>
    <RepositoryUrl>https://github.com/mlambda-net/MLambda.AI</RepositoryUrl>
    <PackageProjectUrl>https://github.com/mlambda-net/MLambda.AI</PackageProjectUrl>
  </PropertyGroup>
  <!-- THE ONLY FILE THAT KNOWS WHERE HILBERT LIVES. Every project writes $(HilbertRoot)\… or
       $(GenesisRoot)\… and nothing else, so migrating to NuGet later is a change here plus one
       ItemGroup per project.

       TWO LAYOUTS ARE REAL, SO THE FIRST CONDITION PROBES BEFORE THE SECOND ASSUMES. Cloned
       beside Genesis, Genesis is a sibling; checked out as Genesis's own submodule at
       modules/MLambda.AI, Genesis is two directories up. The probe asks for Hilbert rather than
       for a directory called MLambda.Genesis, so a renamed checkout still resolves. -->
  <PropertyGroup>
    <GenesisRoot Condition="'$(GenesisRoot)' == '' AND Exists('$(MSBuildThisFileDirectory)..\..\modules\MLambda.Hilbert')">$(MSBuildThisFileDirectory)..\..</GenesisRoot>
    <GenesisRoot Condition="'$(GenesisRoot)' == ''">$(MSBuildThisFileDirectory)..\MLambda.Genesis</GenesisRoot>
    <HilbertRoot Condition="'$(HilbertRoot)' == ''">$(GenesisRoot)\modules\MLambda.Hilbert</HilbertRoot>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- A MISSING GENESIS CHECKOUT IS ONE SENTENCE, NOT NINE MISSING-PROJECT ERRORS.
       BOTH HOOKS ARE LOAD-BEARING. `PrepareForBuild` is early in a build, but restore runs before
       any of it and walks every ProjectReference path — so once those paths point into Genesis,
       restore would fail first with its own wording. `CollectPackageReferences` gets this message
       in front of that too. -->
  <Target Name="MLambdaAiCheckHilbert" BeforeTargets="CollectPackageReferences;PrepareForBuild">
    <Error Condition="!Exists('$(HilbertRoot)\src\MLambda.Hilbert.Compiler\MLambda.Hilbert.targets')"
           Text="MLambda.AI needs an MLambda.Genesis checkout beside it. Expected Hilbert at '$(HilbertRoot)'. Clone MLambda.Genesis (with --recurse-submodules) next to this repository, or pass -p:GenesisRoot=PATH." />
  </Target>
</Project>
